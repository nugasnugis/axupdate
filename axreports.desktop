[Desktop Entry]
Name=axreports
Comment=Host-aware Debian update report and release checker for axupdate
Exec=/usr/local/bin/axreports.py --gui
TryExec=/usr/local/bin/axreports.py
Icon=/usr/share/pixmaps/axreports-brand.svg
Terminal=false
Type=Application
Categories=System;Settings;
StartupWMClass=axreports
